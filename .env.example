# Copy this file to .env and fill in real values.
# Required vars will make the app throw a clear startup error if missing —
# see src/lib/env.js. Optional integrations degrade gracefully when absent.

# --- Database (required) ---
# Get these from Neon (neon.tech) or Supabase (supabase.com), or a local Postgres install.
DATABASE_URL="postgresql://user:password@host:5432/kiyomi?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/kiyomi?sslmode=require"

# --- Auth (required) ---
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-random-64-char-string"
JWT_REFRESH_SECRET="replace-with-a-different-random-64-char-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Stripe (required) ---
# From dashboard.stripe.com/test/apikeys — test mode keys are fine for local dev.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# From the webhook endpoint you create in Phase 7 — placeholder is fine until then.
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Cloudinary (optional — image upload disabled without it) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Resend (optional — emails log to console without it) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="hello@yourdomain.com"

# --- Google Maps (optional — delivery-zone map features disabled without it) ---
GOOGLE_MAPS_API_KEY=""

# --- Twilio / WhatsApp (optional — SMS/WhatsApp notifications no-op without it) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
